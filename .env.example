# Credenciales Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Número de WhatsApp de Twilio (sandbox o producción)
# Formato: whatsapp:+14155238886  o solo +14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# true = servidor webhook en el panel | false = deja /bot al chatbot
WEBHOOK_ENABLED=false
WEBHOOK_PORT=5001

# Recibe mensajes consultando Twilio (funciona con el chatbot en /bot)
MESSAGE_SYNC_ENABLED=true
# 1 = rápido | 0.5 = casi instantáneo (no bajar mucho más por límites Twilio)
MESSAGE_SYNC_INTERVAL=1

# Verificación ligera de chats Martin / Mi numero (segundos, sin bloquear UI)
CHAT_VERIFY_INTERVAL=300

# Sonido al recibir mensajes entrantes (true/false)
NOTIFICATION_SOUND_ENABLED=true

WEBHOOK_PUBLIC_URL=https://tu-subdominio.ngrok-free.dev

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
